{
  "Author": "Rudi",
  "Name": "OPNsense",
  "Description": "Shows OPNsense WAN up- and downstream on your Ulanzi D200.",
  "Detail": "Polls the OPNsense API and displays current upload and download rates in MB/s. Tap to open the OPNsense web UI.",
  "Icon": "assets/icons/pluginIcon.png",
  "Category": "OPNsense",
  "CategoryIcon": "assets/icons/categoryIcon.png",
  "Version": "1.0.0",
  "UUID": "com.ulanzi.ulanzistudio.opnsense",
  "Type": "JavaScript",
  "CodePath": "dist/app.js",
  "PrivateAPI": true,
  "SupportedInMultiActions": false,
  "Actions": [
    {
      "Name": "WAN Traffic",
      "Tooltip": "Live OPNsense up/downstream",
      "Icon": "assets/icons/actionIcon.png",
      "UUID": "com.ulanzi.ulanzistudio.opnsense.traffic",
      "PropertyInspectorPath": "property-inspector/traffic/inspector.html",
      "Controllers": ["Keypad"],
      "Devices": ["D200", "D200H", "D200X"],
      "state": 0,
      "States": [
        {
          "Name": "Status",
          "Image": "assets/icons/status.png"
        }
      ],
      "SupportedInMultiActions": false
    }
  ],
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.11"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinVersion": "2.1.0"
  }
}
